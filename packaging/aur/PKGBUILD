# Maintainer: snake.tech <tolga.urhan@hotmail.de>
# The AUR package kubri-bin, made from the release's .deb. The release workflow fills in the
# version and checksums and generates .SRCINFO; see docs/RELEASING.md.
pkgname=kubri-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='A fast, simple Kubernetes GUI that covers what k9s can do'
arch=('x86_64' 'aarch64')
url='https://github.com/snaketech-tu/kubri'
license=('Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'cairo' 'gdk-pixbuf2' 'glib2' 'libsoup3' 'dbus' 'hicolor-icon-theme')
optdepends=('kubectl: debug containers, k9s plugins that call it'
            'helm: Helm rollbacks, upgrades and installs')
provides=('kubri')
conflicts=('kubri')
options=('!strip' '!debug')
source_x86_64=("https://github.com/snaketech-tu/kubri/releases/download/v${pkgver}/Kubri_${pkgver}_amd64.deb")
source_aarch64=("https://github.com/snaketech-tu/kubri/releases/download/v${pkgver}/Kubri_${pkgver}_arm64.deb")
sha256sums_x86_64=('@SHA256_DEB_AMD64@')
sha256sums_aarch64=('@SHA256_DEB_ARM64@')

package() {
  bsdtar -xf data.tar.gz -C "${pkgdir}"
}
