{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kubri",
  "version": "1.4.0",
  "mainBinaryName": "kubri",
  "identifier": "io.github.snaketech-tu.kubri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kubri",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A fast, simple Kubernetes GUI",
    "longDescription": "A fast, simple and good-looking Kubernetes GUI that covers what k9s can do.",
    "publisher": "SnakeTech",
    "homepage": "https://github.com/snaketech-tu/kubri",
    "license": "Apache-2.0",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
